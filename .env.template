# ═══════════════════════════════════════════════════════════════════════════
# GravitationalWave Platform — Unified Environment Variables Template (v4.16)
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in values. NEVER commit .env to git.
#
# Sections:
#   A. Database Credentials    (MongoDB + Elasticsearch)
#   B. JWT & Auth              (token signing + secrets)
#   C. LLM / AI API Keys       (DeepSeek)
#   D. Docker Compose          (container ports, profiles)
#   E. Rate Limiting           (Bucket4j)
#   F. Logging & Monitoring    (Pipeline, Backend)
#   G. ES Index Names          (centralized index config)
#   H. Frontend Build          (Vite env vars)
#   I. File Size Limits        (Pipeline admission control)
#   J. Tunnel / Network        (SSH tunnel URL)
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# A. DATABASE CREDENTIALS
# ═══════════════════════════════════════════════════════════════════════════

# MongoDB root user (admin database, full cluster access)
# Required by: docker-compose.yml → mongodb container
MONGO_ROOT_PASSWORD=<generate-32-char-random>

# MongoDB application user (gravitationalwave database, readWrite only)
# Required by: docker-compose.yml → mongodb + gw-backend
MONGO_APP_PASSWORD=<generate-32-char-random>

# Elasticsearch password
# Required by: docker-compose.yml → elasticsearch + gw-backend + gw-pipeline
ES_PASSWORD=<generate-32-char-random>

# MongoDB / ES host URIs (production override)
# Used by: gw-backend application-daily.properties / application-prod.properties
#ES_URIS=https://your-es-cluster.example.com:9200
#ES_USERNAME=elastic
#MONGO_HOST=your-mongo.example.com
#MONGO_PORT=27017

# ═══════════════════════════════════════════════════════════════════════════
# B. JWT & AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════════

# JWT signing secret (minimum 32 chars; use `openssl rand -base64 48` to generate)
# Required by: gw-backend application.properties
JWT_SECRET=<generate-64-char-random>

# JWT token expiration in milliseconds (default: 86400000 = 24 hours)
# Optional. Used by: gw-backend JwtUtil.java
#JWT_EXPIRATION=86400000

# JWT refresh window in milliseconds (default: 1800000 = 30 min)
# Optional. Tokens within this window of expiry can be silently refreshed.
#JWT_REFRESH_WINDOW=1800000

# ═══════════════════════════════════════════════════════════════════════════
# C. LLM / AI API KEYS
# ═══════════════════════════════════════════════════════════════════════════

# DeepSeek API key for AI Assistant + Pipeline LLM proxy
# Required by: gw-backend + gw-pipeline + gw-mcp-server
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek daily quota (default: 500 requests/day)
# Optional. Used by: gw-backend LlmController.java
#DEEPSEEK_API_DAILY_QUOTA=500

# DeepSeek cache TTL (default: 30 minutes)
# Optional. Used by: gw-backend LlmController.java
#DEEPSEEK_API_CACHE_TTL_MINUTES=30

# ═══════════════════════════════════════════════════════════════════════════
# D. DOCKER COMPOSE
# ═══════════════════════════════════════════════════════════════════════════

# Nginx CORS domain whitelist (comma-separated, or * for development)
# Optional. Used by: docker-compose.yml → gw-frontend
#NGINX_CORS_DOMAIN=https://your-domain.com

# Backend service URL for nginx proxy
# Optional. Default: http://gw-backend:8093
#BACKEND_SERVICE_URL=http://gw-backend:8093

# MongoDB seed data skip (production mode)
# Set to "true" in docker-compose.prod.yml to prevent demo data insertion
#SKIP_SEED_DATA=true

# ═══════════════════════════════════════════════════════════════════════════
# E. RATE LIMITING (Bucket4j)
# ═══════════════════════════════════════════════════════════════════════════

# Capacity: max requests per IP per refill window
# Optional. Default: 120 (dev), 30 (prod via docker-compose.prod.yml)
#RATE_LIMIT_CAPACITY=120

# Refill window in minutes
# Optional. Default: 1
#RATE_LIMIT_REFILL_MINUTES=1

# Login-specific capacity (anti-brute-force)
# Optional. Default: 5 per 15 min
#RATE_LIMIT_LOGIN_CAPACITY=5
#RATE_LIMIT_LOGIN_REFILL_MINUTES=15

# ═══════════════════════════════════════════════════════════════════════════
# F. LOGGING & MONITORING
# ═══════════════════════════════════════════════════════════════════════════

# Pipeline log directory (inside container)
# Optional. Default: /app/thumbnail_cache/logs
#PIPELINE_LOG_DIR=/app/thumbnail_cache/logs

# Pipeline log level (DEBUG / INFO / WARNING / ERROR)
# Optional. Default: INFO
#PIPELINE_LOG_LEVEL=INFO

# Pipeline log retention (days)
# Optional. Default: 30
#PIPELINE_LOG_MAX_DAYS=30

# Pipeline log max size per task file (MB)
# Optional. Default: 100
#PIPELINE_LOG_MAX_SIZE_MB=100

# Enable JSON structured logging
# Optional. Default: true
#PIPELINE_JSON_LOGGING=true

# Remote log push target (for log-mgmt.sh)
# Optional. Format: user@host:/path
#GW_LOG_REMOTE=admin@log-server:/var/log/gw/

# Notification command for monitor.sh (e.g., webhook)
# Optional. Format: curl -X POST https://hooks.example.com/alert
#NOTIFY_CMD=curl -X POST https://your-webhook-url

# ═══════════════════════════════════════════════════════════════════════════
# G. ES INDEX NAMES (centralized config)
# ═══════════════════════════════════════════════════════════════════════════

# Optional. Defaults: alicptabnormal / errordetail / errorlist
#ES_INDEX_GRAWAVE=alicptabnormal
#ES_INDEX_ERRORDETAIL=errordetail
#ES_INDEX_ERRORLIST=errorlist

# ═══════════════════════════════════════════════════════════════════════════
# H. FRONTEND BUILD (Vite)
# ═══════════════════════════════════════════════════════════════════════════

# Backend base URL for dev proxy
# Optional. Default: http://localhost:8093
#VITE_BACKEND_BASE_URL=http://localhost:8093

# ═══════════════════════════════════════════════════════════════════════════
# I. FILE SIZE LIMITS (Pipeline v4.16)
# ═══════════════════════════════════════════════════════════════════════════

# Max FITS file size for processing (MB)
# Optional. Default: 500
#FITS_MAX_FILE_MB=500

# Small file threshold — below this: full concurrency (MB)
# Optional. Default: 50
#FITS_SMALL_FILE_MB=50

# Medium file threshold (MB)
# Optional. Default: 200
#FITS_MEDIUM_FILE_MB=200

# Thumbnail-specific max file size (MB). Defaults to FITS_MAX_FILE_MB.
# Optional.
#THUMBNAIL_MAX_FILE_MB=500

# Thumbnail cache max total size (MB)
# Optional. Default: 500
#THUMBNAIL_MAX_CACHE_MB=500

# Minimum free disk space before rejecting cache writes (MB)
# Optional. Default: 100
#THUMBNAIL_MIN_FREE_DISK_MB=100

# ═══════════════════════════════════════════════════════════════════════════
# J. LLM TIMEOUTS (Pipeline v4.16)
# ═══════════════════════════════════════════════════════════════════════════

# LLM proxy connect timeout (seconds)
# Optional. Default: 15
#LLM_CONNECT_TIMEOUT_SEC=15

# LLM proxy read timeout (seconds)
# Optional. Default: 120
#LLM_READ_TIMEOUT_SEC=120

# LLM proxy total timeout (seconds)
# Optional. Default: 180
#LLM_TOTAL_TIMEOUT_SEC=180

# LLM proxy max retries on failure
# Optional. Default: 2
#LLM_MAX_RETRIES=2

# ═══════════════════════════════════════════════════════════════════════════
# K. TUNNEL / NETWORK
# ═══════════════════════════════════════════════════════════════════════════

# Serveo.net custom subdomain for SSH tunnel fallback
# Optional. Used by: scripts/tunnel.sh
#GW_TUNNEL_SUBDOMAIN=gwplatform

