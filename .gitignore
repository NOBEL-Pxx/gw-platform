# Local-only deploy artifacts
deploy.local/

# R6.100 #5: deploy audit record (machine-specific, NEVER commit)
#   - write-deploy-record.py writes D:\AliCPT\.deploy-audit\last-deploy.json
#   - Timestamps + operator field + git HEAD make it per-machine state
#   - Remote copy ~/last-deploy.json on zjlab is NOT in this dir
.deploy-audit/
*.local.json
*.local.yml

# Hot-deploy scratch (R6.22 policy: docker cp only for emergency)
hot-deploy/
docker-cp-scratch/

# Version-snapshot backup (replaced by git tag — R6.22)
version-snapshots/

# ─── R6.60.b untracked cleanup (2026-09-06) ────────────────────────────
# Orphan artifacts (build artifacts / test data / cache)
docker-images/             # 4 .tar files (~GB), not in version control
real-data/                 # test data JSON (no need to commit)
sample_data/               # local dev fixtures (application-local.properties, fits, image)
npm-cache/                 # npm cache dir (may contain private keys, never commit)

# Build artifacts (generalized from gw-backend/**/target)
**/target/
**/build/
**/__pycache__/
**/*.pyc
**/*.class
**/dist/
**/node_modules/
**/.venv/
**/venv/

# ONNX model binaries (~60MB ea, downloaded by gw-pipeline/scripts/download_models.py)
gw-pipeline/models/*.onnx
