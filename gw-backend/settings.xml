<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- R6.69: China-first mirror tiering — Maven mirror is first-match-wins,
         so China mirrors MUST come BEFORE central (which is unreachable from
         this network). See docs/ops/github-pat-escalation.md §R6.68 额外发现. -->
    <mirrors>
        <!-- Tier 1: Tencent Cloud (lowest latency in China) -->
        <mirror>
            <id>tencent</id>
            <mirrorOf>central</mirrorOf>
            <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>
        </mirror>
        <!-- Tier 2: Huawei Cloud (fallback) -->
        <mirror>
            <id>huawei</id>
            <mirrorOf>central</mirrorOf>
            <url>https://repo.huaweicloud.com/repository/maven/</url>
        </mirror>
        <!-- Tier 3: Aliyun (third fallback) -->
        <mirror>
            <id>aliyun</id>
            <mirrorOf>central</mirrorOf>
            <url>https://maven.aliyun.com/repository/public</url>
        </mirror>
        <!-- Last resort: Maven Central (only if all mirrors fail) -->
        <mirror>
            <id>central</id>
            <mirrorOf>central</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>

    <!-- Build profiles: enable parallel downloads + retry -->
    <profiles>
        <profile>
            <id>build</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties>
                <maven.wagon.http.retryHandler.count>10</maven.wagon.http.retryHandler.count>
                <maven.wagon.http.connectionTimeout>30000</maven.wagon.http.connectionTimeout>
                <maven.wagon.http.readTimeout>120000</maven.wagon.http.readTimeout>
                <maven.wagon.http.pool>true</maven.wagon.http.pool>
            </properties>
        </profile>
    </profiles>
</settings>
