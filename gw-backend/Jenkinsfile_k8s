pipeline {
  agent {
    kubernetes {
      yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                    - key: kubernetes.io/hostname
                      operator: In
                      values:
                        - cn-hangzhou-zjy-d01.10.200.60.116
          containers:
          - name: maven
            image: m.daocloud.io/docker.io/maven:3.9-eclipse-temurin-21
            command:
            - cat
            tty: true
            volumeMounts:
             - mountPath: /root/.m2
               name: maven-m2
          - name: docker
            image: m.daocloud.io/docker.io/docker:dind
            command:
            - cat
            tty: true
            volumeMounts:
             - mountPath: /var/run/docker.sock
               name: docker-sock
             - mountPath: /root/.m2
               name: maven-m2
          volumes:
          - name: maven-m2
            hostPath:
              path: /data/ops/maven/m2
          - name: docker-sock
            hostPath:
              path: /var/run/docker.sock
        '''
    }
  }
  environment {
    IMAGE_TAG = "v${env.BUILD_NUMBER}_${params.env}"
    PARAM_ENV = "${params.env}"
  }

  stages {
    stage('Build-Jar-file') {
      steps {
        container('maven') {
          echo "当前分支: ${env.GIT_BRANCH}"
          echo "当前Commit ID: ${env.GIT_COMMIT}"
          sh 'mvn clean package -pl start -Dautoconfig.interactive=false -U -DskipTests=true -Dmaven.test.skip=true -Dmaven.javadoc.skip=true -am'
          sh 'rm -rf /root/.m2/app-build/* && cp -rf start/target/start.jar /root/.m2/app-build/gravitational-wave-backend.jar'
          sh 'cp start.sh /root/.m2/app-build/'
        }
      }
    }
    stage('Build-Docker-Image') {
      steps {
        container('docker') {
          sh "docker build -f Dockerfile --build-arg APP_NAME=gravitational-wave-backend --build-arg APP_BRANCH=${env.GIT_BRANCH} --build-arg APP_COMMITID=${env.GIT_COMMIT} --build-arg JENKINS_BUILDNUM=${BUILD_NUMBER} --build-arg APP_RUN_ENV=${env.PARAM_ENV} -t gravitational-wave-backend:${env.IMAGE_TAG} /root/.m2/app-build/"
        }
      }
    }
    stage('Login-Into-Docker') {
      steps {
        container('docker') {
          sh "docker login --username=ascm-org-1710208820455 cr.registry.res.cloud.zhejianglab.com -p 'zjlab@2024'"
      }
    }
    }
     stage('Push-Images-Docker-to-DockerHub') {
      steps {
        container('docker') {
          sh "docker tag gravitational-wave-backend:${env.IMAGE_TAG} cr.registry.res.cloud.zhejianglab.com/gravitationalwave/gravitational-wave-backend:${env.IMAGE_TAG}"
          sh "docker push cr.registry.res.cloud.zhejianglab.com/gravitationalwave/gravitational-wave-backend:${env.IMAGE_TAG}"
      }
    }
     }
  }
    post {
      always {
        container('docker') {
          sh 'docker logout'
      }
      }
    }
}