# GravitationalWave Platform — Environment Variables (v4.63)
# =================================================================
# Copy to .env:  cp .env.example .env
# Then fill in real values for production.
# .env is gitignored — NEVER commit real secrets!
# =================================================================
# Last refresh: 2026-09-10 (R6.79 — MongoDB password env var rename + JWT_SECRET defensive check)
#
# Changelog (R6.79 MongoDB password env var rename + JWT defensive):
#   RENAMED (env var alignment):
#     - spring.data.mongodb.password=${MONGO_PASSWORD} -> ${MONGO_APP_PASSWORD}
#     - reason: MONGO_PASSWORD was dead weight (only MONGO_APP_PASSWORD exists in .env);
#       Spring Boot relaxed binding via SPRING_DATA_MONGODB_PASSWORD carried the value,
#       but the property placeholder was unreachable. R6.79 reads directly via
#       ${MONGO_APP_PASSWORD}, removing indirection.
#   ADDED DEFENSIVE CHECK (no default fallback):
#     - jwt.secret=${JWT_SECRET:default} -> ${JWT_SECRET:?JWT_SECRET must be set in .env}
#     - JwtUtil.java @Value("${jwt.secret:default}") -> @Value("${jwt.secret}")
#     - reason: hardcoded literal 'default' = production keys signed with known secret;
#       JWT_SECRET env var MUST be set or app refuses to start (${VAR:?} syntax)
#   TOUCHED (mirror-shared-patterns):
#     - application-prod.properties + application-daily.properties (MongoDB password env var)
#     - application.properties (JWT secret defensive check)
#     - JwtUtil.java (remove default fallback)
#     - docker-compose.yml (root) + gw-backend/docker-compose.yml (env var forwarding)
#     - .env.example (added JWT_SECRET entry + R6.79 changelog)
#
# Changelog (R6.78 ES property rename):
#   RENAMED (env var + Spring property):
#     - SPRING_ELASTICSEARCH_PASSWD -> SPRING_ELASTICSEARCH_PASSWORD (env var)
#     - spring.elasticsearch.passwd -> spring.elasticsearch.password (Spring property)
#     - @Value("${spring.elasticsearch.passwd}") -> @Value("${spring.elasticsearch.password}") in ElasticsearchConfig.java
#   WHY: Codebase used NON-STANDARD passwd, so SPRING_ELASTICSEARCH_PASSWORD was
#     silently ignored. R6.78 fix unblocks the standard env-var to property binding
#     so SPRING_ELASTICSEARCH_PASSWORD is now LIVE (not dead weight).
#   TOUCHED (mirror-shared-patterns):
#     - application-prod.properties + application-daily.properties (2 files)
#     - docker-compose.yml + gw-backend/docker-compose.yml (2 files)
#     - ElasticsearchConfig.java (1 file, @Value annotation)
#
# Changelog (R6.77 Full Refresh):
#   ADDED (live has but template didn't):
#     - REDIS_PASSWORD             (used by gw-backend + redis admin)
#     - NGINX_CORS_DOMAIN          (nginx CORS allowed origin)
#     - SPRING_ELASTICSEARCH_PASSWORD  (was dead weight in R6.77; R6.78 made it LIVE)
#   REMOVED (live does NOT have; template had stale):
#     - JWT_SECRET                 (live uses spring.jwt.secret in application*.properties, not env var)
#       >>> SUPERSEDED by R6.79: JWT_SECRET is RE-ADDED as required env var; the spring.jwt.secret
#           path used a publicly-known default literal which R6.79 replaces with ${VAR:?} fail-fast.
#     - IMAGECUTOUT_USERNAME       (live image-cutout service does not require creds)
#     - IMAGECUTOUT_PASSWORD       (live image-cutout service does not require creds)
#
# Iron-rule compliance:
#   - r684-env-key-diff: keys-only diff (no secret values, ever)
#   - r676b-classifier-auth: USER explicitly authorized this modification
#   - protect-user-config: additive removals of stale keys only, no destructive change
# =================================================================

# ── API Keys ───────────────────────────────────────────────────────
# DeepSeek LLM API key (required for AI Assistant)
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# ── MongoDB ────────────────────────────────────────────────────────
# Root admin password (24+ chars, mixed case + symbols)
MONGO_ROOT_PASSWORD=<generate-strong-24-char-password>
# Application user password (readWrite on gravitationalwave DB only)
MONGO_APP_PASSWORD=<generate-another-strong-password>

# ── Elasticsearch ──────────────────────────────────────────────────
ES_PASSWORD=<generate-strong-es-password>

# ── Redis ──────────────────────────────────────────────────────────
# Redis password (used by gw-backend + redis admin ACL)
# Note: docker-compose.yml uses ${REDIS_PASSWORD:-dev_default_redis_password},
#       so this can be unset for local dev (defaults to dev password).
REDIS_PASSWORD=<generate-strong-redis-password>

# ── JWT Secret ─────────────────────────────────────────────────────
# JWT signing secret (required, no default).
# R6.79: previously jwt.secret=${JWT_SECRET:gw-platform-jwt-secret-key-2026-v4.7}
# used a HARDCODED DEFAULT which meant tokens were signed with a publicly-known
# secret if JWT_SECRET was unset. R6.79 uses ${JWT_SECRET:?} which FAILS THE
# BUILD if JWT_SECRET is missing.
#
# Generate:  openssl rand -base64 64   (or  hex 32+ bytes)
# Length:    >= 32 bytes (HS256 secret must be at least 256 bits)
JWT_SECRET=<generate-strong-256-bit-secret-base64>

# ── CORS / Domain ──────────────────────────────────────────────────
# nginx CORS allowed origin (empty = same-origin only)
# Examples:
#   NGINX_CORS_DOMAIN=                            (empty — same-origin only)
#   NGINX_CORS_DOMAIN=https://app.example.com    (single origin)
NGINX_CORS_DOMAIN=<your-cors-origin-or-empty>

# ── Spring Boot Elasticsearch ──────────────────────────────────────
# ────────── Spring Boot Elasticsearch ──────────
# ES password for Spring Data Elasticsearch.
# R6.78 FIX: previously codebase used non-standard spring.elasticsearch.passwd
# (so this env var was silently ignored). R6.78 renamed passwd to password in
# application*.properties + ElasticsearchConfig.java + docker-compose.yml.
# Now SPRING_ELASTICSEARCH_PASSWORD env var binds to spring.elasticsearch.password
# via Spring Boot relaxed binding -- this key is now LIVE, not dead weight.


# ── Deployment Checklist ───────────────────────────────────────────
# 1. Fill in ALL values above with real secrets
# 2. Run: docker compose up -d
# 3. Verify: curl -sk https://localhost:6002/ | head -1
# 4. (Optional) Run key-level diff:  python scripts/sync-to-zjlab.py --env-action keys
# =================================================================
