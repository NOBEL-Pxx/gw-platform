# GravitationalWave Platform — Environment Variables (v4.12)
# =================================================================
# Copy to .env:  cp .env.example .env
# Then fill in real values for production.
# .env is gitignored — NEVER commit real secrets!
# =================================================================

# ── API Keys ───────────────────────────────────────────────────────
# DeepSeek LLM API key (required for AI Assistant)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ── MongoDB ────────────────────────────────────────────────────────
# Root admin password (24+ chars, mixed case + symbols)
MONGO_ROOT_PASSWORD=generate-a-strong-24-char-password-here
# Application user password (readWrite on gravitationalwave DB only)
MONGO_APP_PASSWORD=generate-another-strong-password-or-reuse-above

# ── Elasticsearch ──────────────────────────────────────────────────
ES_PASSWORD=generate-a-strong-es-password-here

# ── JWT Authentication ─────────────────────────────────────────────
# Secret key for signing JWT tokens (64 random hex chars recommended)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate-a-random-64-char-hex-string-here

# ── Image Cutout Service (external) ────────────────────────────────
IMAGECUTOUT_USERNAME=your-username
IMAGECUTOUT_PASSWORD=your-password

# ── Deployment Checklist ───────────────────────────────────────────
# 1. Fill in ALL values above with real secrets
# 2. Run: docker compose up -d
# 3. Verify: curl -sk https://localhost:6002/ | head -1
# =================================================================
