{
  "name": "gravitationalwave-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "commitlint": "commitlint --edit",
    "dev": "tsc -b&& vite build --mode development",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "vite --mode development",
    "subset-fonts": "python scripts/subset-fonts.py",
    "subset-fonts:verify": "python scripts/subset-fonts.py --verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "ahooks": "^3.8.1",
    "aladin-lite": "^3.6.5",
    "antd": "^5.22.0",
    "axios": "^1.7.7",
    "firefly-api-access": "^0.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.6",
    "postcss": "^8.4.48",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "prebuild": "npm run subset-fonts",
  "subset-fonts:pages": "python scripts/subset-fonts.py --pages-only"
}
